# Device Monitoring Platform - Environment Configuration

# ===========================================
# COPY THIS FILE AND CUSTOMIZE AS NEEDED
# ===========================================

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=device_monitoring
MYSQL_USER=monitoring_user
MYSQL_PASSWORD=your_secure_monitoring_password

# Server Configuration
DATABASE_URL=mysql+pymysql://monitoring_user:your_secure_monitoring_password@database:3306/device_monitoring
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Device Monitoring Platform

# Client Configuration (for host monitoring)
USER_ID=your-unique-user-id
SERVER_URL=http://localhost:8000/api/devices/data
SEND_INTERVAL=10
MAX_RETRIES=5
RETRY_DELAY=5

# Network Configuration
# Default ports - change if these conflict with existing services
DASHBOARD_PORT=3000
SERVER_PORT=8000
DATABASE_PORT=3306

# Docker Configuration
COMPOSE_PROJECT_NAME=device-monitoring
RESTART_POLICY=unless-stopped

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration (for production)
# ENABLE_HTTPS=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# JWT_SECRET=your-jwt-secret-key
# API_KEY=your-api-key

# Monitoring Configuration
DATA_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24
MAX_DEVICES_PER_USER=10

# Performance Configuration
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
CACHE_TTL_SECONDS=300